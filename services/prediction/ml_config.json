{
  "_comment": "Cấu hình ML dùng chung cho training/, services/prediction và services/clustering. Giá trị theo thảo luận Issue #13 (Hiếu, Định, Vũ); riêng percentile 75 và cutoff 0.5 là cấu hình khởi đầu, chỉnh bằng validation. Khi sửa file này, huấn luyện lại (python training/train_models.py).",
  "metric": "http_traffic",
  "timezone": "Asia/Ho_Chi_Minh",
  "min_hours_per_day": 24,
  "horizon_days": 2,
  "risk": {
    "metric": "l7_attack",
    "percentile": 75,
    "proba_cutoff": 0.5,
    "label_high": "Cao",
    "label_low": "Thấp"
  },
  "features": {
    "lags": [2, 7],
    "windows": [3, 7]
  },
  "cluster": {
    "k_range": [2, 6],
    "k": 3,
    "weak_silhouette": 0.25,
    "features": [
      {"name": "http_mean", "metric": "http_traffic", "agg": "mean"},
      {"name": "l7_max", "metric": "l7_attack", "agg": "max"},
      {"name": "bot_mean", "metric": "bot_share", "agg": "mean"}
    ],
    "roles": {"traffic": "http_mean", "attack": ["l7_max", "bot_mean"]},
    "names": {"normal": "Bình thường", "peak": "Cao điểm", "anomaly": "Bất thường"},
    "fallback_name": "Cụm {n}"
  },
  "training": {
    "test_ratio": 0.2,
    "min_days": 30,
    "seed": 42,
    "rf_estimators": 300,
    "regressor_target": "delta"
  }
}
