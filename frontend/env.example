# Chạy riêng giao diện (npm run dev) với dữ liệu minh họa có nhãn trên UI, không cần backend.
# Ở chế độ này nút Chạy lại bị khóa.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dùng dữ liệu thật khi backend đang chạy (docker compose up). Docker/Compose mặc định là api.
# NEXT_PUBLIC_DATA_MODE=api
