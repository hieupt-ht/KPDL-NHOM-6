# Token Cloudflare giả; thay khi triển khai ingestion thật.
CF_API_TOKEN=replace-with-cloudflare-token
# Tên và tài khoản quản trị của Warehouse.
WAREHOUSE_DB=warehouse
WAREHOUSE_ADMIN_USER=warehouse_admin
WAREHOUSE_ADMIN_PASSWORD=change-warehouse-admin-password
# Tên và tài khoản quản trị của Mart.
MART_DB=mart
MART_ADMIN_USER=mart_admin
MART_ADMIN_PASSWORD=change-mart-admin-password
# Mật khẩu các tài khoản ứng dụng PostgreSQL.
INGESTION_DB_PASSWORD=change-ingestion-password
LOGIC_DB_PASSWORD=change-logic-password
API_DB_PASSWORD=change-api-password
# Tài khoản quản trị Keycloak; chỉ dùng giá trị giả khi phát triển.
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-keycloak-admin-password
KEYCLOAK_ISSUER=http://localhost:8080/realms/cyber-radar
KEYCLOAK_CLIENT_ID=dashboard
# Đồng bộ giá trị giả này với keycloak/realm-export.json khi bật đăng nhập thật.
KEYCLOAK_CLIENT_SECRET=change-me-client-secret
AUTH_SECRET=change-auth-secret-at-least-32-characters
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_ENABLED=false
# Bật hoặc tắt các lịch chạy stub.
SCHEDULER_ENABLED=true
INGESTION_INTERVAL_SECONDS=300
ANALYSIS_INTERVAL_SECONDS=300
PREDICTION_INTERVAL_SECONDS=300
CLUSTERING_CRON_HOUR=0
CLUSTERING_CRON_MINUTE=30
TZ_LOCAL=Asia/Ho_Chi_Minh
