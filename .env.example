# Token Cloudflare Radar (chỉ đọc). Bắt buộc để ingestion lấy dữ liệu thật:
# giữ nguyên giá trị mẫu thì ingestion báo lỗi cấu hình và không có dữ liệu.
CF_API_TOKEN=replace-with-cloudflare-token
# Tên và tài khoản quản trị của Warehouse.
WAREHOUSE_DB=warehouse
WAREHOUSE_ADMIN_USER=warehouse_admin
WAREHOUSE_ADMIN_PASSWORD=change-warehouse-admin-password
# Tên và tài khoản quản trị của Mart.
MART_DB=mart
MART_ADMIN_USER=mart_admin
MART_ADMIN_PASSWORD=change-mart-admin-password
# Mật khẩu các tài khoản ứng dụng PostgreSQL.
INGESTION_DB_PASSWORD=change-ingestion-password
LOGIC_DB_PASSWORD=change-logic-password
API_DB_PASSWORD=change-api-password
# Token chung giữa API và các service /run; không dùng để đăng nhập dashboard.
JOB_TRIGGER_TOKEN=local-job-trigger-token
JOB_REQUEST_TIMEOUT_SECONDS=10
# Local API: export các biến này; Compose dùng tên service nội bộ.
ANALYSIS_URL=http://localhost:8001
CLUSTERING_URL=http://localhost:8002
PREDICTION_URL=http://localhost:8003
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DATA_MODE=api
# Timeout của API đọc Mart.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
# Bật hoặc tắt lịch chạy tự động của các service; false thì chỉ chạy khi gọi /run
# (ingestion cũng không backfill nền).
SCHEDULER_ENABLED=true
INGESTION_INTERVAL_SECONDS=300
# Độ sâu backfill lịch sử của ingestion, tính bằng ngày; backfill tự dừng khi Radar hết dữ liệu cũ.
BACKFILL_TARGET_DAYS=365
ANALYSIS_INTERVAL_SECONDS=300
PREDICTION_INTERVAL_SECONDS=300
CLUSTERING_CRON_HOUR=0
CLUSTERING_CRON_MINUTE=30
TZ_LOCAL=Asia/Ho_Chi_Minh
